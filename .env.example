# jev-provider environment example.
#
# Copy to .env. Setup (A) is active; to use another, comment out (A) and
# uncomment ONE of (B), (C), (D) or (E) below.
# Placeholders only: never commit real keys. Provider keys are read from the
# named environment variables and are never logged or echoed; startup errors
# name variables, not values. An empty value counts as unset.
#
# How the default provider/model is chosen at startup:
#   - exactly one provider configured -> it is the default; DEFAULT_PROVIDER is optional
#   - more than one provider          -> DEFAULT_PROVIDER is required (or a
#                                        MODEL_ROUTES_JSON route for DEFAULT_JEV_MODEL)
#   - no provider                     -> startup error
#   - DEFAULT_PROVIDER naming a provider that is not configured -> startup error

# ---------------------------------------------------------------------------
# (A) Anthropic Messages API only (the default case)
# ---------------------------------------------------------------------------
# Provider "anthropic", type messages-api, https://api.anthropic.com/v1/messages,
# adaptive thinking, effort medium, max_tokens 16000.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# (B) OpenAI Responses API only
# ---------------------------------------------------------------------------
# Provider "openai", type responses-api, https://api.openai.com/v1/responses,
# store false, strict json_schema output. Comment out (A) when using this.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-astra

# ---------------------------------------------------------------------------
# (C) Both keys: DEFAULT_PROVIDER is required
# ---------------------------------------------------------------------------
# Both built-in providers are configured. Choose the default provider and set
# its model. The other provider stays configured and is reachable through
# MODEL_ROUTES_JSON aliases (see D).
#
# C1: default to Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEFAULT_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-5-5
#
# C2: default to OpenAI
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEFAULT_PROVIDER=openai
# OPENAI_MODEL=gpt-6-astra

# ---------------------------------------------------------------------------
# (D) Advanced: explicit registry and routes
# ---------------------------------------------------------------------------
# PROVIDERS_JSON replaces the built-in registry; keys are referenced by
# env-var name (api_key_env), never placed in the JSON. MODEL_ROUTES_JSON
# replaces the generated default route. Here jev-latest goes to Anthropic
# (so it is the default for DEFAULT_JEV_MODEL=jev-latest), jev-deep is a
# Messages route with its own effort/thinking/max_tokens, and jev-openai goes
# to the Responses provider with reasoning effort and an output-token cap
# (sent as reasoning.effort and max_output_tokens; omit both to send neither).
# DEFAULT_PROVIDER also picks the provider for ALLOW_PASSTHROUGH_MODEL.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEFAULT_PROVIDER=anthropic
# PROVIDERS_JSON={"anthropic":{"type":"messages-api","url":"https://api.anthropic.com/v1/messages","api_key_env":"ANTHROPIC_API_KEY","timeout_ms":60000},"openai":{"type":"responses-api","url":"https://api.openai.com/v1/responses","api_key_env":"OPENAI_API_KEY","store":false,"output_mode":"json_schema","timeout_ms":20000,"max_retries":0,"max_in_flight":768}}
# Set a versioned response_model per route (the model reported to callers)
# and change it when the route's upstream model or settings change.
# MODEL_ROUTES_JSON={"jev-latest":{"provider":"anthropic","model":"claude-haiku-5-5","response_model":"jev-claude-2026-10-13","thinking":"adaptive","effort":"medium","max_tokens":16000},"jev-deep":{"provider":"anthropic","model":"claude-sonnet-5-5","response_model":"jev-deep-2026-10-13","thinking":"adaptive","effort":"high","max_tokens":32000},"jev-openai":{"provider":"openai","model":"gpt-6-astra","response_model":"jev-openai-2026-10-13","effort":"medium","max_tokens":32000}}

# ---------------------------------------------------------------------------
# (E) Local mock upstream
# ---------------------------------------------------------------------------
# Start the mock first: `cargo run -p jev-mock` (listens on 127.0.0.1:8090).
# Comment out (A) and the server block below, then uncomment this block. The
# mock accepts any non-empty key; set the scenario per provider with the
# x-mock-scenario header. See README "Local testing with jev-mock".
# MOCK_API_KEY=mock-key
# BIND_ADDR=127.0.0.1:8080
# DEFAULT_PROVIDER=mock-anthropic
# PROVIDERS_JSON={"mock-anthropic":{"type":"messages-api","url":"http://127.0.0.1:8090/v1/messages","api_key_env":"MOCK_API_KEY","timeout_ms":5000},"mock-openai":{"type":"responses-api","url":"http://127.0.0.1:8090/v1/responses","api_key_env":"MOCK_API_KEY","timeout_ms":5000},"mock-refusal":{"type":"messages-api","url":"http://127.0.0.1:8090/v1/messages","api_key_env":"MOCK_API_KEY","headers":{"x-mock-scenario":"refusal"}}}
# MODEL_ROUTES_JSON={"jev-latest":{"provider":"mock-anthropic","model":"claude-haiku-5-5"},"jev-openai":{"provider":"mock-openai","model":"gpt-mock"},"jev-refusal":{"provider":"mock-refusal","model":"claude-haiku-5-5"}}
#
# Mock process settings (read by jev-mock, defaults shown):
# MOCK_BIND=127.0.0.1:8090
# MOCK_SCENARIO=ok
# MOCK_CAPTURE=100
# MOCK_MAX_BODY_BYTES=4194304
# MOCK_REQUIRE_KEY=

# ---------------------------------------------------------------------------
# Routing (defaults shown)
# ---------------------------------------------------------------------------
# DEFAULT_JEV_MODEL=jev-latest
# ALLOW_PASSTHROUGH_MODEL=false
# X-Upstream-* response headers name upstream providers and models; off by default.
# EXPOSE_UPSTREAM_HEADERS=false

# ---------------------------------------------------------------------------
# Server and auth (defaults shown)
# ---------------------------------------------------------------------------
BIND_ADDR=0.0.0.0:8080
# Comma-separated Jev-facing Bearer tokens. Empty/unset disables local auth.
GATEWAY_API_KEYS=local-dev-key
SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------------------
# Throughput / latency (defaults shown)
# ---------------------------------------------------------------------------
MAX_IN_FLIGHT=1024
ADMISSION_WAIT_MS=5
POOL_MAX_IDLE_PER_HOST=256
POOL_IDLE_TIMEOUT_MS=90000

# ---------------------------------------------------------------------------
# Request and response limits (defaults shown)
# ---------------------------------------------------------------------------
MAX_BODY_BYTES=524288
# Bound on reading request headers and body; minimum 100. Slow bodies get 408.
REQUEST_READ_TIMEOUT_MS=10000
MAX_UPSTREAM_BYTES=1048576
MAX_QUESTIONS=32
MAX_CHOICE_OPTIONS=255
MAX_SCORE_LEVELS=10
MAX_JSON_DEPTH=32
# Text units (words; one per Han, kana or Thai character) that make question
# instructions, descriptions or state meaningful. Minimum 1; 0 fails at startup.
# MIN_DESCRIPTION_WORDS=3

# ---------------------------------------------------------------------------
# Idempotency cache (defaults shown)
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_MAX_ENTRIES=100000
