# jev-provider container environment (template).
#
# Copy to deploy/.env.ubuntu2604 (git-ignored) and fill in. Read by
# `docker compose` (env_file in deploy/compose.yaml) and passed into the
# jev-provider container. After any edit, recreate the container:
#   docker compose up -d --force-recreate jev-provider
#
# Format rules (docker compose env_file):
#   - one KEY=VALUE per line, no `export`, no spaces around `=`
#   - JSON values stay on ONE line; no inline comments after a value
#   - an empty value counts as unset
#   - never commit this file; keys are read from here only, never logged
#
# ACTIVE NOW: block (M), the bundled jev-mock upstream, so the stack runs
# without real keys. Block (M) needs the mock profile:
#   docker compose --profile mock up -d --build
# To go live, comment out every line of (M) and uncomment exactly ONE of
# (A), (B), (C) or (D); then a plain `docker compose up -d --build` is enough.
#
# How the default provider is chosen at startup:
#   - exactly one provider configured -> it is the default
#   - more than one                   -> DEFAULT_PROVIDER is required
#   - none                            -> startup error (container restarts in a loop;
#                                        see `docker compose logs jev-provider`)

# ===========================================================================
# (M) Mock upstream (ACTIVE): jev-mock service at http://jev-mock:8090
# ===========================================================================
# Needs the mock profile (`--profile mock`); without it jev-mock is not
# started and POST /v1/systemone cannot reach the upstream.
# Any non-empty key is accepted by the mock. Routes:
#   jev-latest  -> Messages API mock (default)
#   jev-openai  -> Responses API mock
#   jev-refusal -> Messages API mock forced to refuse (expect 422 provider_refused)
# Other mock scenarios via a provider "headers" entry {"x-mock-scenario":"..."}:
#   ok, refusal, max_tokens, no_text, bad_json, wrong_shape[:<n>], oversize[:<bytes>],
#   no_usage, http_<status>, slow:<ms>, flaky:<n>
MOCK_API_KEY=mock-key
DEFAULT_PROVIDER=mock-anthropic
PROVIDERS_JSON={"mock-anthropic":{"type":"messages-api","url":"http://jev-mock:8090/v1/messages","api_key_env":"MOCK_API_KEY","timeout_ms":5000},"mock-openai":{"type":"responses-api","url":"http://jev-mock:8090/v1/responses","api_key_env":"MOCK_API_KEY","timeout_ms":5000},"mock-refusal":{"type":"messages-api","url":"http://jev-mock:8090/v1/messages","api_key_env":"MOCK_API_KEY","headers":{"x-mock-scenario":"refusal"}}}
MODEL_ROUTES_JSON={"jev-latest":{"provider":"mock-anthropic","model":"claude-haiku-5-5","response_model":"jev-mock-2026-10-20"},"jev-openai":{"provider":"mock-openai","model":"gpt-mock","response_model":"jev-mock-openai-2026-10-20"},"jev-refusal":{"provider":"mock-refusal","model":"claude-haiku-5-5"}}

# ===========================================================================
# (A) Anthropic Messages API only
# ===========================================================================
# Built-in provider "anthropic": https://api.anthropic.com/v1/messages,
# adaptive thinking, effort medium, max_tokens 16000.
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# ANTHROPIC_MODEL=claude-haiku-5-5

# ===========================================================================
# (B) OpenAI Responses API only
# ===========================================================================
# Built-in provider "openai": https://api.openai.com/v1/responses,
# store false, strict json_schema output.
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-6-astra

# ===========================================================================
# (C) Both keys: DEFAULT_PROVIDER is required
# ===========================================================================
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME
# DEFAULT_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-6-astra

# ===========================================================================
# (D) Advanced: explicit registry and routes (both providers)
# ===========================================================================
# PROVIDERS_JSON replaces the built-in registry; keys are referenced by env-var
# name (api_key_env), never placed in the JSON. Set a versioned response_model
# per route and change it whenever the route's model or settings change.
# On the responses-api route, effort and max_tokens are sent as
# reasoning.effort and max_output_tokens; omit both to send neither.
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPENAI_API_KEY=sk-REPLACE_ME
# DEFAULT_PROVIDER=anthropic
# PROVIDERS_JSON={"anthropic":{"type":"messages-api","url":"https://api.anthropic.com/v1/messages","api_key_env":"ANTHROPIC_API_KEY","timeout_ms":60000,"max_retries":1},"openai":{"type":"responses-api","url":"https://api.openai.com/v1/responses","api_key_env":"OPENAI_API_KEY","store":false,"timeout_ms":20000}}
# MODEL_ROUTES_JSON={"jev-latest":{"provider":"anthropic","model":"claude-haiku-5-5","response_model":"jev-claude-2026-10-20"},"jev-deep":{"provider":"anthropic","model":"claude-sonnet-5-5","response_model":"jev-deep-2026-10-20","effort":"high","max_tokens":32000},"jev-openai":{"provider":"openai","model":"gpt-6-astra","response_model":"jev-openai-2026-10-20","effort":"medium","max_tokens":32000}}

# ===========================================================================
# Server and auth
# ===========================================================================
# Keep 0.0.0.0:8080 inside the container; compose publishes it on host :8080.
BIND_ADDR=0.0.0.0:8080
# Comma-separated Bearer tokens callers must send (Authorization: Bearer <token>).
# Generate one with `openssl rand -hex 24`; add more comma-separated as needed.
# Empty disables auth: do NOT leave empty once real provider keys are set,
# because port 8080 is reachable from the LAN.
GATEWAY_API_KEYS=REPLACE_WITH_RANDOM_TOKEN
SHUTDOWN_GRACE_MS=10000

# ===========================================================================
# Routing (defaults shown)
# ===========================================================================
# DEFAULT_JEV_MODEL=jev-latest
# ALLOW_PASSTHROUGH_MODEL=false
# X-Upstream-* headers reveal upstream provider/model names; off by default.
# EXPOSE_UPSTREAM_HEADERS=false

# ===========================================================================
# Throughput / latency (defaults shown)
# ===========================================================================
# MAX_IN_FLIGHT=1024
# ADMISSION_WAIT_MS=5
# POOL_MAX_IDLE_PER_HOST=256
# POOL_IDLE_TIMEOUT_MS=90000

# ===========================================================================
# Request and response limits (defaults shown)
# ===========================================================================
# MAX_BODY_BYTES=524288
# Bound on reading request headers and body (min 100); slow clients get 408.
# Also closes keep-alive connections idle longer than this.
# REQUEST_READ_TIMEOUT_MS=10000
# MAX_UPSTREAM_BYTES=1048576
# MAX_QUESTIONS=32
# MAX_CHOICE_OPTIONS=255
# MAX_SCORE_LEVELS=10
# MAX_JSON_DEPTH=32
# Text units (words; one per Han, kana or Thai character) that make question
# instructions, descriptions or state meaningful. Minimum 1; 0 fails at startup.
# MIN_DESCRIPTION_WORDS=3

# ===========================================================================
# Idempotency cache (defaults shown)
# ===========================================================================
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_MAX_ENTRIES=100000
